{
  "definitions": [
    {
      "title": "Feature Highlight",
      "id": "feature-highlight",
      "model": "feature-highlight",
      "plugins": {
        "da": {
          "name": "feature-highlight",
          "rows": 2,
          "columns": 1,
          "fields": [
            {
              "name": "eyebrow",
              "selector": "div:nth-child(1) > div > p:nth-of-type(1)"
            },
            {
              "name": "heading",
              "selector": "div:nth-child(1) h2"
            },
            {
              "name": "description",
              "selector": "div:nth-child(1) > div > p:nth-of-type(2)"
            },
            {
              "name": "features",
              "selector": "div:nth-child(1) ul"
            },
            {
              "name": "link",
              "selector": "div:nth-child(1) > div > p:nth-of-type(3) a"
            },
            {
              "name": "footnote",
              "selector": "div:nth-child(1) > div > p:last-of-type"
            },
            {
              "name": "image",
              "selector": "div:nth-child(2) picture img[src]"
            },
            {
              "name": "imageAlt",
              "selector": "div:nth-child(2) picture img[alt]"
            }
          ]
        }
      }
    }
  ],
