{
  "definitions": [
    {
      "title": "Cards Testimonial",
      "id": "cards-testimonial",
      "filter": "cards-testimonial",
      "plugins": {
        "da": {
          "name": "cards-testimonial",
          "rows": 1,
          "columns": 2
        }
      }
    },
    {
      "title": "Testimonial Card",
      "id": "cards-testimonial-item",
      "model": "cards-testimonial-item",
      "plugins": {
        "da": {
          "name": "cards-testimonial-item",
          "rows": 1,
          "columns": 2,
          "fields": [
            {
              "name": "image",
              "selector": "div:nth-child(1) picture img[src]"
            },
            {
              "name": "imageAlt",
              "selector": "div:nth-child(1) picture img[alt]"
            },
            {
              "name": "eyebrow",
              "selector": "div:nth-child(2) > p:nth-of-type(1)"
            },
            {
              "name": "heading",
              "selector": "div:nth-child(2) h3"
            },
            {
              "name": "description",
              "selector": "div:nth-child(2) > p:nth-of-type(2)"
            },
            {
              "name": "attribution",
              "selector": "div:nth-child(2) > p:nth-of-type(3)"
            },
            {
              "name": "link",
              "selector": "div:nth-child(2) a"
            }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "cards-testimonial-item",
      "fields": [
